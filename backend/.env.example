# Monad testnet
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Wallet that funds each new ephemeral player session (needs testnet MON — see faucet.monad.xyz)
FUNDER_PRIVATE_KEY=0x...

# Amount of MON (in ether units) auto-funded to a new player session on first join.
# IMPORTANT: Monad testnet charges for the full declared gasLimit per tx,
# not actual gas used (confirmed via a real receipt — see chain.js
# TX_OVERRIDES comment). With gasLimit=200,000 @ 210 gwei max fee, each
# write costs ~0.021-0.042 MON depending on effective price. 0.3 covers a
# full race's worth of moves with real margin; do NOT raise gasLimit
# thinking it's a free safety net — it directly multiplies cost here.
SESSION_FUND_AMOUNT=0.3

# Secret used to deterministically derive each session wallet from its
# playerId (keccak256(SESSION_SEED:playerId) as the private key). This is
# what makes a player's address stable across backend restarts/redeploys —
# without it, session wallets were random and stored only in memory, so
# every deploy silently reassigned everyone a new address and broke
# "You're not a participant in this race" for anyone who'd registered
# before the redeploy. Generate a real one with `cast wallet new` and keep
# it secret — anyone with this value can derive any player's private key.
SESSION_SEED=0x...

# Deployed contract address (from `forge create` output)
CONTRACT_ADDRESS=0x...

PORT=8787

# Monad testnet
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Wallet that funds each new ephemeral player session (needs testnet MON — see faucet.monad.xyz)
FUNDER_PRIVATE_KEY=0x...

# Amount of MON (in ether units) auto-funded to a new player session on first join.
# Must clear chain.js's TX_OVERRIDES.gasLimit * maxFeePerGas (currently
# 1,000,000 * 210 gwei = 0.21 MON worst case) plus the entry fee — under
# that and every write from this session mempool-rejects as "insufficient
# balance" deterministically, every time, not flakily. 0.3 has real margin.
SESSION_FUND_AMOUNT=0.3

# Deployed contract address (from `forge create` output)
CONTRACT_ADDRESS=0x...

PORT=8787
